rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // We allow public read/write for custom products and gallery photos during this migration.
    // In a production app, we would restrict write access to authenticated admins.
    match /custom_products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
